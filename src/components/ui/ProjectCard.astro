---
import type { Project } from "../../data/portfolio";
import TechnologyIcon, { technologyMeta } from "./TechnologyIcon";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="surface-card">
  <a href={project.href} class="group flex w-full flex-col gap-3 p-3 no-underline sm:p-4" aria-label={`Ver ${project.title}`}>
    <div class="project-visual">
      <p class="project-visual-title">{project.title}</p>
      <div class="project-preview" role="img" aria-label={`Vista previa de ${project.title}`}></div>
    </div>

    <div class="flex items-center justify-between gap-4">
      <h3 class="text-lg font-extrabold tracking-[-.06em] text-black sm:text-xl">{project.title}</h3>
      <span class="project-link" aria-hidden="true">&#8601;</span>
    </div>

    <p class="text-sm leading-[1.7] text-[#637084]">{project.description}</p>

    <div class="flex flex-wrap gap-2" aria-label="Tecnolog&iacute;as utilizadas">
      {project.technologies.map((technologyKey) => {
        const technology = technologyMeta[technologyKey];

        return (
          <span class="project-technology" role="img" aria-label={technology.label} style={`--technology-color: ${technology.color}`}>
            <TechnologyIcon icon={technologyKey} size={18} />
            <span class="project-technology-name">{technology.label}</span>
          </span>
        );
      })}
    </div>
  </a>
</article>
