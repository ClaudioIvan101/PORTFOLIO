---
import { finalCta, site } from "../../data/portfolio";
import SectionHeading from "../ui/SectionHeading.astro";

const cleanDigits = site.phone.replace(/\D/g, "");
const whatsappNumber = cleanDigits.startsWith("54") && !cleanDigits.startsWith("549")
  ? `549${cleanDigits.slice(2)}`
  : cleanDigits;
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hola Claudio, vi tu portfolio y me gustaría conversar con vos sobre una oportunidad.")}`;
---

<section id="cta-final" class="page-section bg-[#f6f4ef]">
  <div class="mx-auto w-full max-w-[1500px]">
    <SectionHeading title="Construyamos algo." />
    <div class="cta-panel flex flex-col items-start justify-between gap-8 p-7 text-[#f6f4ef] sm:p-12 md:flex-row md:items-end lg:p-16">
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-[.16em] text-[#f8d8cc]">{finalCta.availability}</p>
        <h3 class="mt-8 max-w-3xl text-[clamp(2.2rem,6vw,5.5rem)] font-extrabold leading-[1] tracking-[-.06em] sm:mt-10 sm:leading-[.9]">{finalCta.title}</h3>
        <p class="mt-5 max-w-xl text-base leading-[1.7] text-[#f6f4ef]/75 sm:mt-6 sm:text-xl">{finalCta.description}</p>
      </div>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full shrink-0 rounded-2xl bg-[#e85d35] px-7 py-4 text-center text-sm font-bold uppercase tracking-[.13em] text-[#17201c] shadow-[0_8px_15px_rgba(0,0,0,.18)] transition hover:-translate-y-0.5 hover:bg-[#f6f4ef] sm:w-auto"
      >
        {finalCta.actionLabel} &nearr;
      </a>
    </div>
  </div>
</section>
