---
import { finalCta } from "../../data/portfolio";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="cta-final" class="page-section bg-[#f6f4ef]">
  <SectionHeading title="Construyamos algo." />
  <div class="cta-panel flex flex-col items-start justify-between gap-10 p-8 text-[#f6f4ef] sm:p-12 md:flex-row md:items-end lg:p-16">
    <div>
      <p class="font-mono text-xs font-bold uppercase tracking-[.16em] text-[#f8d8cc]">{finalCta.availability}</p>
      <h3 class="mt-10 max-w-3xl text-[clamp(2.8rem,6vw,6rem)] font-extrabold leading-[.86] tracking-[-.075em]">{finalCta.title}</h3>
      <p class="mt-6 max-w-xl text-lg leading-[1.7] text-[#f6f4ef]/72 sm:text-xl">{finalCta.description}</p>
    </div>
    <a href="#contacto" class="shrink-0 rounded-2xl bg-[#e85d35] px-7 py-4 text-sm font-bold uppercase tracking-[.13em] text-[#17201c] shadow-[0_8px_15px_rgba(0,0,0,.18)] transition hover:-translate-y-0.5 hover:bg-[#f6f4ef]">{finalCta.actionLabel} &nearr;</a>
  </div>
</section>
