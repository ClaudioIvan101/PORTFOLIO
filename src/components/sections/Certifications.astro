---
import { certifications } from "../../data/portfolio";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="certificaciones" class="page-section bg-[#f6f4ef]">
  <div class="mx-auto w-full max-w-[1500px]">
    <SectionHeading title="Certificaciones" />
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((cert) => (
          <article class="surface-card flex flex-col justify-between p-6 sm:p-7">
            <div>
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#e85d35]">
                  {cert.issuer}
                </span>
                <span class="rounded-full bg-[rgba(39,54,74,0.06)] px-2.5 py-0.5 font-mono text-xs font-semibold text-[#637084]">
                  {cert.year}
                </span>
              </div>
              <h3 class="mt-4 text-xl font-bold tracking-tight text-black sm:text-2xl">
                {cert.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[#637084]">
                {cert.description}
              </p>
            </div>

            {cert.tags && cert.tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2 border-t border-[rgba(23,32,28,0.08)] pt-4">
                {cert.tags.map((tag) => (
                  <span class="rounded-md border border-[rgba(23,32,28,0.12)] bg-[#f6f4ef] px-2.5 py-1 text-xs font-medium text-[#27364a]">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
